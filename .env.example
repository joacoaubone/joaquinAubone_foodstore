# Copiar a .env y reemplazar los valores locales antes de iniciar el migrador.
DATABASE_URL=jdbc:postgresql://localhost:5432/foodstore
DATABASE_USERNAME=foodstore
DATABASE_PASSWORD=replace-with-a-local-database-password
DB_POOL_SIZE=10

# Debe ser un hash BCrypt válido, generado con strength 12. No guardar la contraseña real aquí.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-strength-12-hash
