# Copiar a .env y reemplazar todos los marcadores antes de iniciar el migrador o la API.
# Nunca guardar el archivo .env real en Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/foodstore
DATABASE_USERNAME=foodstore
DATABASE_PASSWORD=replace-with-a-local-database-password
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms

# Debe ser Base64 de al menos 32 bytes aleatorios (HS256). No usar este marcador como secreto.
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes

# Debe ser un hash BCrypt válido de strength 12. No guardar la contraseña real aquí.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-strength-12-hash

# Vigencias de tokens de sesión
ACCESS_TOKEN_TTL=PT30M
REFRESH_TOKEN_TTL=P7D

# Cookies. Para desarrollo HTTP local se puede usar AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

# Límite de intentos R-1
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15

# Executor BCrypt adoptado por el proyecto: 2 workers y cola de 4x este valor.
FOODSTORE_BCRYPT_MAX_CONCURRENTE=2
